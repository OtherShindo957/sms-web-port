Reason: Clang (the browser build's Emscripten compiler) rejects an alias declared as an array of unknown size; under __EMSCRIPTEN__ the three retail-name data exports take their definition's complete type with __typeof__. The ELF/COFF and Mach-O spellings are unchanged.
--- a/src/MoveBG/MapObjInit.cpp
+++ b/src/MoveBG/MapObjInit.cpp
@@ -10816,6 +10816,9 @@
 // Code mods (sms_mod/modhooks.h) name this by its retail map name.
 #if defined(__APPLE__)
 __asm__(".globl _sObjDataTable\n.set _sObjDataTable, __ZL13sObjDataTable");
+#elif defined(__EMSCRIPTEN__)
+// Clang needs the array's size in an alias declaration: take the definition's type.
+extern __typeof__(sObjDataTable) portExport_sObjDataTable __asm__("sObjDataTable") __attribute__((alias("_ZL13sObjDataTable")));
 #else
 extern TMapObjData* portExport_sObjDataTable[] __asm__("sObjDataTable") __attribute__((alias("_ZL13sObjDataTable")));
 #endif
